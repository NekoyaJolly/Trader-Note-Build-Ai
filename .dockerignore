# Dependencies
node_modules
npm-debug.log

# Environment variables (重要: これを含めないと本番でローカル設定が使われて事故る)
.env
.env.*
!.env.example

# Next.js build output (コンテナ内で再ビルドする)
.next
src/frontend/.next

# Git
.git
.gitignore

# Build output
dist
coverage

# Docs & misc
# *.md 全体を除外 → README / ルートドキュメントを減量。
# ただしランタイム `loadPrompt()` が実行時に読み込む
# src/side-b/prompts/ 配下の .md は例外として許可しないと
# Docker ビルドコンテキストから欠落し、本番で "Prompt file not found" になる。
*.md
!src/side-b/prompts/**/*.md
docs/
.agent/
.gemini/
