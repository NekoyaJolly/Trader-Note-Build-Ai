{
  "name": "trader-note-build-ai",
  "version": "1.0.0",
  "description": "TradeAssist - ノート主体のインテリジェント取引支援システム",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy:assets && npm run build:frontend",
    "build:backend": "npx prisma generate && tsc && npm run copy:assets",
    "copy:assets": "node scripts/copy-assets.js",
    "build:frontend": "cd src/frontend && npm run build",
    "start": "node dist/index.js",
    "kill:ports": "node scripts/kill-ports.js 3100 3102",
    "dev": "npm run kill:ports && concurrently \"cross-env BACKEND_PORT=3100 nodemon src/index.ts\" \"cd src/frontend && npm run dev\"",
    "dev:backend": "npm run kill:ports && cross-env BACKEND_PORT=3100 nodemon src/index.ts",
    "dev:frontend": "node scripts/kill-ports.js 3102 && cd src/frontend && npm run dev",
    "lint:backend": "eslint \"src/**/*.ts\" --ignore-pattern \"src/frontend/**\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.spec.ts\"",
    "lint:backend:tests": "eslint \"src/**/*.test.ts\" \"src/**/*.spec.ts\" --ignore-pattern \"src/frontend/**\"",
    "lint:backend:files": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:format": "prisma format",
    "test": "jest",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:integration:db": "jest --config jest.db.config.ts --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:production": "playwright test -c playwright.production.config.ts",
    "test:e2e:production:public": "playwright test -c playwright.production.config.ts tests/e2e/production-public.spec.ts",
    "test:e2e:production:auth": "tsx scripts/production-auth-setup.ts",
    "test:e2e:production:walkthrough": "tsx scripts/production-ui-walkthrough.ts",
    "test:e2e:production:functional": "tsx scripts/production-functional-test.ts",
    "test:e2e:production:backtest": "tsx scripts/production-backtest-test.ts",
    "verify:ctrader-data": "tsx scripts/verify-ctrader-data-fetch.ts",
    "fetch:ohlcv-range": "tsx scripts/fetch-ohlcv-range.ts",
    "fetch:spread-bars-range": "tsx scripts/fetch-spread-bars-range.ts",
    "debug:ctrader-tick-raw": "tsx scripts/debug-ctrader-tick-raw.ts",
    "verify:ctrader-fetch-ui": "tsx scripts/production-verify-ctrader-fetch-ui.ts",
    "verify:ohlcv-save": "tsx scripts/verify-ohlcv-save-and-verify.ts",
    "verify:ohlcv-parallel-limit": "tsx scripts/verify-ohlcv-parallel-limit.ts",
    "mcp-server": "npx ts-node src/mcp-server/index.ts",
    "cli:show-scoring": "tsx src/side-b/cli/showRecentScoring.ts",
    "prepare": "node scripts/install-git-hooks.js"
  },
  "engines": {
    "node": ">=20.17"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/adk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@prisma/client": "^6.19.2",
    "@reiryoku/ctrader-layer": "^2.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.0.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.12.0",
    "bcrypt": "^6.0.0",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.66.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "indicatorts": "^2.2.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.9.0",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.40.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.8",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "babel-jest": "^30.4.1",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.11",
    "openai": "^6.16.0",
    "prisma": "^6.19.2",
    "simple-git-hooks": "^2.13.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  },
  "overrides": {
    "axios": "^1.12.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint"
    ]
  }
}
