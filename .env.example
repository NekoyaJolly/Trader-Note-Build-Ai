# データベース接続設定（実値はコミットしないこと）
# 注意: Prisma は DATABASE_URL を直接参照するため、この名前を使用すること
# 本番（Cloud Run + Supabase）: ?connection_limit=3 を付けて接続枯渇を防ぐ
#   例: postgresql://user:pass@host:5432/db?connection_limit=3
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradeassist
# Prisma用の直接接続URL（必要な環境のみ設定）
DIRECT_URL=
# DBパスワードを分離管理する構成向け（必要な環境のみ設定）
DATABASE_PASSWORD=

# サーバー設定
# npm run dev は cross-env で BACKEND_PORT=3100 を付与するが、単体起動時用に明示してもよい
PORT=3100
BACKEND_PORT=3100
NODE_ENV=development

# ============================================
# analysis-engine（Python / pandas-ta）設定
# ============================================
# Docker Compose 利用時のデフォルト: http://analysis-engine:8000
# ローカル直起動で Python を 8000 で起動する場合: http://localhost:8000
ANALYSIS_ENGINE_URL=http://localhost:8000

# Python 検証（WalkForward 等）の実行方式
# ローカル: docker_exec（python/docker-compose.yml の side_b_python_validator を docker exec）
# 本番: http（analysis-engine の /health /v1/walk-forward を HTTP 呼び出し）
PYTHON_VALIDATION_MODE=docker_exec
# 未設定なら ANALYSIS_ENGINE_URL を利用。ローカルで HTTP mode を試す場合: http://localhost:8000
PYTHON_VALIDATION_URL=
# Python検証のタイムアウト(ms)
PYTHON_VALIDATION_TIMEOUT_MS=300000
# docker_exec mode 用（通常は既定値でOK）
PYTHON_BRIDGE_CONTAINER=side_b_python_validator
PYTHON_BRIDGE_SHARED_DIR=python/shared
PYTHON_BRIDGE_TIMEOUT_MS=300000

# ============================================
# JWT認証設定（本番環境では必ず変更すること）
# ============================================
# アクセストークン署名用秘密鍵（32文字以上推奨）
JWT_SECRET=your-jwt-secret-change-in-production
# リフレッシュトークン署名用秘密鍵（32文字以上推奨）
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# ============================================
# Web Push通知設定
# ============================================
# VAPID鍵の生成: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ============================================
# AI サービス設定
# ============================================
AI_API_KEY=
# 現行の推奨: Gemini（OpenAI互換エンドポイント）
# - AI_BASE_URL を Google の OpenAI互換URL にすると、既存の /chat/completions 実装を流用できる
# - AI_API_KEY は Google AI Studio/ Gemini の APIキー（例: AIza...）を想定
AI_MODEL=gemini-3-flash-preview
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# test環境でAI外部APIを呼ばない既定。実APIテスト時のみ false
AI_API_MOCK=true

# --------------------------------------------
# reasoning モデル思考レベル (AI_REASONING_EFFORT)
# --------------------------------------------
# OpenAI の reasoning モデル (gpt-5 系 / o 系) で使用される思考レベル。
# 値: none | minimal | low | medium | high | xhigh   (既定: high)
# 非 reasoning モデル (gpt-4o, anthropic/*, google/* 等) では送信されない。
AI_REASONING_EFFORT=high

# --------------------------------------------
# 一括モデル切替 (AI_MODEL_OVERRIDE_ALL)
# --------------------------------------------
# 設定すると全エージェント/サービスのモデルが上書きされる (個別 AI_MODEL_<KEY> より優先)。
# 用途:
#   - テスト中にコストを抑えたい (全部 gpt-4o-mini に振る等)
#   - OpenRouter から特定プロバイダの直 API に一時的に切り替えたい
# 未設定なら個別キー (AI_MODEL_STRATEGIST 等) → ハードコード既定値が使われる (現状互換)。
# AI_MODEL_OVERRIDE_ALL=

# --------------------------------------------
# プロバイダ切替例 (一時用、コメントアウト)
# --------------------------------------------
# OpenRouter (本番既定) — モデル ID は "anthropic/claude-opus-4.7" 等のスラッシュ形式
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=<OPENROUTER_KEY>
#
# OpenAI 直 — モデル ID はスラッシュ無し ("gpt-4o-mini" 等)
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL_OVERRIDE_ALL=gpt-4o-mini
#
# Gemini 直 (OpenAI 互換) — モデル ID は "gemini-2.0-flash" 等
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=AIza...
# AI_MODEL_OVERRIDE_ALL=gemini-2.0-flash

# ============================================
# Firecrawl（Web調査/スクレイピング用、任意）
# ============================================
FIRECRAWL_API_KEY=

# ============================================
# 市場データ API（Twelve Data）
# ============================================
TWELVE_DATA_API_KEY=

# レガシー設定（後方互換性・通常は未設定）
MARKET_API_URL=
MARKET_API_KEY=

# ============================================
# 通知・スケジューラー設定
# ============================================
PUSH_NOTIFICATION_KEY=

# マッチング設定
MATCH_THRESHOLD=0.75
CHECK_INTERVAL_MINUTES=15

# CRONスケジューラー（本番環境ではtrue）
CRON_ENABLED=false

# ============================================
# Side-B AI自動取引スケジューラー設定
# ============================================
# trueに設定するとサーバー起動時にSide-Bスケジューラーが自動開始
# 毎朝9時（JST）にリサーチ→プラン→トレード作成が自動実行される
SIDE_B_SCHEDULER_ENABLED=false

# ============================================
# Wave 1 G1 (2026-05-18): EdgeHypothesis 24h ハードリミット (default: OFF)
# ============================================
# Last-Mile 探索で「EURUSD 15m に 539 件 / 7日で 654 件」を観察した応急処置として
# 実装したが、Discovery 自動挿入の削除 (2026-05-16) で直近 24h は 12 件に収束したため、
# Neko 判断で「default OFF」に方針変更 (2026-05-18 Wave 1 完了後)。
# コード本体 / DEFAULT_DAILY_HARDLIMITS / env 制御は恒久残置、実ユーザー流入時に
# UI からのユーザー設定に置換予定。
# 'true' を明示的に設定したときのみ ledger が hardlimit を発火する。
# HYPOTHESIS_HARDLIMIT_ENABLED=true
# HYPOTHESIS_HARDLIMIT_AI_GENERATED_24H=5
# HYPOTHESIS_HARDLIMIT_DISCOVERY_24H=5
# HYPOTHESIS_HARDLIMIT_REFLECTION_24H=5
# HYPOTHESIS_HARDLIMIT_USER_INPUT_24H=5
# HYPOTHESIS_HARDLIMIT_BACKTEST_24H=5

# ============================================
# Cron認証設定（Railway/Vercel Cron用）
# ============================================
# 外部Cronサービスからの呼び出しを認証するための秘密鍵
# 生成例: openssl rand -hex 32
# 呼び出し例: curl -H "Authorization: Bearer <secret>" https://api.example.com/api/cron/health
CRON_SECRET=

# ============================================
# cTrader Open API 設定（Side-A リアルタイム通知用）
# ============================================
# cTrader Open API アプリケーション設定
# 取得先: https://openapi.ctrader.com/
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# OAuth コールバック URL（本番・プレビューでは cTrader アプリと完全一致必須）
# ローカル: ブラウザが localhost / 127.0.0.1 のときは redirect は自動で現在の origin に合わせる。
#   cTrader の Redirect URIs に http://localhost:3102/auth/ctrader/callback（ポートに合わせる）を登録すればよい。
#   手順の要約: docs/cTrader-localhost-cheatsheet.md
CTRADER_REDIRECT_URI=https://trader-note-build-ai.vercel.app/auth/ctrader/callback

# ============================================
# AI Testing（E2Eテスト用）
# ============================================
# 追加プロバイダーを利用する場合のみ設定
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# Frontend（Vercel / ローカル Next）設定
# ============================================
# ブラウザから API を叩く先。ローカルでは必ずバックエンド（PORT=3100）を指すこと。
# 未設定だとフロント origin に /api/... が飛び 404 になりやすい。
# src/frontend/.env.local にコピーして使う場合も同様。
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3100
NEXT_PUBLIC_ENV=development
