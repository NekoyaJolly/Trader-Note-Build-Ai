// フェーズ8: 複数ノート運用UX - 同時ヒット制御
// ============================================================

/// 通知バッチ設定（同時ヒット制御のグローバル設定）
/// システム全体で1レコードのみ保持（シングルトン）
model NotificationBatchConfig {
  id              String   @id @default(uuid()) @db.Uuid
  /// 同時に送信する最大通知数（デフォルト3）
  maxSimultaneous Int      @default(3)
  /// シンボル別にグループ化するか（trueの場合、シンボルごとにmaxSimultaneous適用）
  groupBySymbol   Boolean  @default(true)
  /// クールダウン時間（分）- 同一ノートへの連続通知を抑制
  cooldownMinutes Int      @default(15)
  /// 作成日時
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  /// 更新日時
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
}

/// 通知スキップログ（同時ヒット制御でスキップされた通知の記録）
/// デバッグ・分析用。なぜ通知されなかったかを追跡可能にする
model NotificationSkipLog {
  id            String                 @id @default(uuid()) @db.Uuid
  /// スキップされた TradeNote ID
  noteId        String                 @db.Uuid
  /// マッチ結果 ID（任意）
  matchResultId String?                @db.Uuid
  /// スキップ理由
  reason        NotificationSkipReason
  /// 詳細情報（JSON形式で任意のメタデータ）
  details       Json?
  /// スキップ発生日時
  skippedAt     DateTime               @default(now()) @db.Timestamptz(6)

  note        TradeNote    @relation("NotificationSkipLogNote", fields: [noteId], references: [id])
  matchResult MatchResult? @relation("NotificationSkipLogMatch", fields: [matchResultId], references: [id])

  @@index([noteId], map: "idx_notification_skip_note")
  @@index([skippedAt], map: "idx_notification_skip_at")
  @@index([reason], map: "idx_notification_skip_reason")
}

/// 通知スキップ理由
enum NotificationSkipReason {
  /// 同時ヒット数上限超過（優先度が低いためスキップ）
  max_simultaneous_exceeded
  /// クールダウン中（同一ノートへの連続通知抑制）
  cooldown_active
  /// ノートが無効化されている
  note_disabled
  /// ノートが一時停止中
  note_paused
  /// 優先度が低い（同一シンボル内で優先度負け）
  lower_priority
}

/// ノート統一コア（NOTE_SIMILARITY_FOUNDATION.md §7/§8 テーブル戦略B、Phase α-2 新設）
///
/// Side-A(TradeNote) / Side-B(AITradeNote) 共通の「マッチング・監視単位」のコア。
/// ノート特徴の正準形 lensSnapshot(JSONB) と所有ユーザー(userId)を持ち、
/// マルチユーザー化(completion-roadmap §7 決定1)とノート統一を同じ migration で実現する。
///
/// 段階移行(同設計書 §9)中の役割分担:
/// - 本テーブル = 特徴(lensSnapshot) + 同一性 + 来歴 + ユーザー帰属
/// - 運用フィールド(status/enabled/pausedUntil/priority)の正は引き続き TradeNote
///   (運用統一は Phase ε のノート統一仕上げで扱う)
model Note {
  id                    String     @id @default(uuid()) @db.Uuid
  /// 所有ユーザー（Phase 6 で必須化）。過去の NULL 行は migration でバックフィル済み。
  userId                String     @db.Uuid
  /// ノートの出自（side_a_human = 人間の実トレード / side_b_ai = AI の仮想トレード）
  source                NoteSource
  /// 銘柄シンボル（例: USDJPY）
  symbol                String
  /// 売買方向（Side-B の long/short は buy/sell に正規化して保持。設計書 §7）
  side                  TradeSide
  /// 主時間足（例: 15m）
  timeframe             String
  /// 上位足（任意、MTF 文脈）
  higherTimeframe       String?
  /// エントリー価格
  entryPrice            Decimal?   @db.Decimal(18, 8)
  /// ノート＝トレード時刻（lensSnapshot.eventTime と一致）
  eventTime             DateTime   @db.Timestamptz(6)
  /// ノート特徴の正準形（NoteLensSnapshot JSON）。null = 未生成 or 生成失敗（比較対象外）
  lensSnapshot          Json?
  /// lensSnapshot 内 snapshotSchemaVersion の写し（再生成対象の抽出など SQL フィルタ用）
  snapshotSchemaVersion String?
  /// 来歴: Side-A TradeNote へのブリッジ（1:1）
  tradeNoteId           String?    @unique @db.Uuid
  /// 来歴: Side-B AITradeNote へのブリッジ（1:1）
  aiTradeNoteId         String?    @unique @db.Uuid
  /// 作成日時
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)
  /// 更新日時
  updatedAt             DateTime   @updatedAt @db.Timestamptz(6)

  user        User         @relation("UserNotes", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tradeNote   TradeNote?   @relation(fields: [tradeNoteId], references: [id])
  aiTradeNote AITradeNote? @relation(fields: [aiTradeNoteId], references: [id])

  @@index([userId], map: "idx_note_user")
  @@index([symbol, source], map: "idx_note_symbol_source")
  @@index([eventTime], map: "idx_note_event_time")
}

/// Note コアの出自
enum NoteSource {
  /// Side-A: 人間の実トレード由来
  side_a_human
  /// Side-B: AI の仮想トレード由来
  side_b_ai
}

/// マッチングパイプライン実行単位の記録（P1: observability）
/// MatchingService.runMatchingPipeline() の 1 実行 = 1 行。
/// cron 実行ごとに「いつ動いたか / 何件マッチ・通知・スキップしたか / なぜ通知されなかったか」
/// を runId 単位で追跡できるようにする。マッチ単位の証跡は MatchResult / NotificationLog /
/// EvaluationLog が担い、本テーブルは run（cron サイクル）単位の集計を担う。
model MatchingPipelineRun {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 起動元（cron / manual_test / scheduler / unknown）
  trigger      String                    @default("unknown")
  /// 実行全体の状態
  status       MatchingPipelineRunStatus @default(success)
  /// 開始時刻
  startedAt    DateTime                  @db.Timestamptz(6)
  /// 終了時刻
  finishedAt   DateTime                  @db.Timestamptz(6)
  /// 実行時間（ミリ秒）
  durationMs   Int
  /// マッチ総数
  totalMatches Int                       @default(0)
  /// 通知作成成功数
  notified     Int                       @default(0)
  /// 通知スキップ数
  skipped      Int                       @default(0)
  /// エラー数
  errorCount   Int                       @default(0)
  /// エラー要約（短縮テキストの配列。raw payload は保存しない）
  errors       String[]
  /// スキップ理由の集計（reason code -> 件数。例: {"cooldown":2,"score_below_threshold":3}）
  skipReasons  Json?
  /// 市場状態（休場スキップ理由など。通常実行時は null）
  marketStatus String?
  /// レコード作成日時
  createdAt    DateTime                  @default(now()) @db.Timestamptz(6)

  @@index([startedAt(sort: Desc)], map: "idx_pipeline_run_started")
  @@index([status, startedAt(sort: Desc)], map: "idx_pipeline_run_status_started")
}

/// MatchingPipelineRun の状態
enum MatchingPipelineRunStatus {
  /// 全マッチを処理し、通知エラーなし
  success
  /// 市場休場などで実行自体をスキップ
  skipped
  /// 一部の通知でエラーが発生したが処理は継続
  partial_failure
  /// パイプライン全体が失敗
  failed
}

