# データベース接続設定（実値はコミットしないこと）
# 注意: Prisma は DATABASE_URL を直接参照するため、この名前を使用すること
# 本番（Cloud Run + Supabase）: ?connection_limit=3 を付けて接続枯渇を防ぐ
#   例: postgresql://user:pass@host:5432/db?connection_limit=3
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradeassist
# Prisma用の直接接続URL（必要な環境のみ設定）
DIRECT_URL=
# DBパスワードを分離管理する構成向け（必要な環境のみ設定）
DATABASE_PASSWORD=

# サーバー設定
PORT=3100
NODE_ENV=development

# ============================================
# analysis-engine（Python / pandas-ta）設定
# ============================================
# Docker Compose 利用時のデフォルト: http://analysis-engine:8000
# ローカル直起動で Python を 8000 で起動する場合: http://localhost:8000
ANALYSIS_ENGINE_URL=http://localhost:8000

# ============================================
# JWT認証設定（本番環境では必ず変更すること）
# ============================================
# アクセストークン署名用秘密鍵（32文字以上推奨）
JWT_SECRET=your-jwt-secret-change-in-production
# リフレッシュトークン署名用秘密鍵（32文字以上推奨）
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# ============================================
# Web Push通知設定
# ============================================
# VAPID鍵の生成: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ============================================
# AI サービス設定
# ============================================
AI_API_KEY=
# 現行の推奨: Gemini（OpenAI互換エンドポイント）
# - AI_BASE_URL を Google の OpenAI互換URL にすると、既存の /chat/completions 実装を流用できる
# - AI_API_KEY は Google AI Studio/ Gemini の APIキー（例: AIza...）を想定
AI_MODEL=gemini-3-flash-preview
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ============================================
# 市場データ API（Twelve Data）
# ============================================
TWELVE_DATA_API_KEY=

# レガシー設定（後方互換性・通常は未設定）
MARKET_API_URL=
MARKET_API_KEY=

# ============================================
# 通知・スケジューラー設定
# ============================================
PUSH_NOTIFICATION_KEY=

# マッチング設定
MATCH_THRESHOLD=0.75
CHECK_INTERVAL_MINUTES=15

# CRONスケジューラー（本番環境ではtrue）
CRON_ENABLED=false

# ============================================
# Side-B AI自動取引スケジューラー設定
# ============================================
# trueに設定するとサーバー起動時にSide-Bスケジューラーが自動開始
# 毎朝9時（JST）にリサーチ→プラン→トレード作成が自動実行される
SIDE_B_SCHEDULER_ENABLED=false

# ============================================
# Cron認証設定（Railway/Vercel Cron用）
# ============================================
# 外部Cronサービスからの呼び出しを認証するための秘密鍵
# 生成例: openssl rand -hex 32
# 呼び出し例: curl -H "Authorization: Bearer <secret>" https://api.example.com/api/cron/health
CRON_SECRET=

# ============================================
# cTrader Open API 設定（Side-A リアルタイム通知用）
# ============================================
# cTrader Open API アプリケーション設定
# 取得先: https://openapi.ctrader.com/
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# OAuth コールバック URL（デフォルト: Vercel 本番）
CTRADER_REDIRECT_URI=https://trader-note-build-ai.vercel.app/auth/ctrader/callback

# ============================================
# AI Testing（E2Eテスト用）
# ============================================
# 追加プロバイダーを利用する場合のみ設定
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# Frontend（Vercel）設定
# ============================================
# ブラウザ側で参照される公開環境変数
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3100
NEXT_PUBLIC_ENV=development
